## Virtual Health Assistant (Backend) - Example Environment
##
## Copy to `backend/.env` and adjust if needed.
## Windows PowerShell:
##   Copy-Item .env.example .env

# Database (PostgreSQL recommended)
# Use the included docker-compose.yml to run a local Postgres:
#   docker compose up -d db
DATABASE_URL=postgresql://vha:vha_password@localhost:5432/virtual_health_assistant

# Secrets (replace if deploying anywhere real)
SECRET_KEY=dev-secret-key-change-me
JWT_SECRET_KEY=dev-jwt-secret-key-change-me

# Frontend dev server (Vite is configured to run on port 3000)
CORS_ORIGINS=http://localhost:3000

# Optional: if ML model artifacts are missing, enable deterministic fallback predictions
# (useful for demos/tests; not real ML)
# DEMO_ML_FALLBACK=1

# Optional: set explicitly (defaults to development when running python run.py)
# FLASK_ENV=development

